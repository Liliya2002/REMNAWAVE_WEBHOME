# Единая нормализация переводов строк: в репозитории — LF, в рабочей копии — LF.
# eol=lf перекрывает core.autocrlf, поэтому на Windows больше нет CRLF-шумов.
* text=auto eol=lf

# Текстовые типы проекта
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.svg    text eol=lf
*.conf   text eol=lf
*.template text eol=lf

# Бинарные файлы — не трогать
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
